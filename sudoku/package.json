{
  "name": "sudoku-root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @sudoku/app dev",
    "typecheck": "node scripts/check-docs.mjs && pnpm -r --sequential typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @sudoku/app build && node scripts/check-bundle.mjs",
    "validate:m1": "SUDOKU_PROP_PUZZLES=40 pnpm --filter @sudoku/engine test",
    "validate:visual": "pnpm --filter sudoku-e2e test:visual"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
