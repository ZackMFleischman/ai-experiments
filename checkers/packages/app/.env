# Firebase web-app config for the production project (checkers-zmf).
# ⚑ owner: register checkers-zmf and paste its public identifiers here (safe to
# commit — see GAME-SETUP.md §11). Dev/emulator runs ignore these entirely
# (demo-checkers), and the default build is firebase-free, so the placeholders
# below only matter to the (⚑-gated) firebase deploy job.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=checkers-zmf.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=checkers-zmf
VITE_FIREBASE_STORAGE_BUCKET=checkers-zmf.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
