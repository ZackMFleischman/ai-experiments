{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-experiments app registry",
  "type": "object",
  "required": ["apps"],
  "properties": {
    "$schema": { "type": "string" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dir", "kind", "displayName", "tagline", "glyph", "accent", "status", "webUrl", "firebaseProject", "linkedParlor", "workflows"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "dir": { "type": "string" },
          "kind": { "enum": ["duo", "solo", "arcade", "utility", "other"] },
          "players": {
            "description": "Seats the app supports. Required for game kinds, absent for \"other\". A duo game is 2..2 unless it says otherwise; a solo/arcade/utility app is 1..1.",
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 }
            }
          },
          "displayName": { "type": "string" },
          "tagline": { "type": "string" },
          "glyph": { "type": "string" },
          "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "status": { "enum": ["live", "built", "coming-soon"] },
          "webUrl": { "type": ["string", "null"], "pattern": "^https?://" },
          "firebaseProject": { "type": ["string", "null"] },
          "linkedParlor": { "type": "array", "items": { "type": "string" } },
          "workflows": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
