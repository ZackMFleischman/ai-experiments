rules_version = '2';

// Tracks the canonical parlor reference (../parlor/firestore.rules,
// PARLOR-PLATFORM-HARDENING.md Phase 1) — enforced by `scripts/check-rules-parity.mjs`
// in `pnpm typecheck`. hive is a perfect-information game, so it uses the base
// tiers verbatim (no rack/private override).
// DESIGN §5.2/§5.3: every game mutation goes through a callable — clients get
// NO write access to games/* or invites/*. Game docs (and their move logs) are
// readable only by their two players; invites by anyone signed in holding the
// code; the only client-writable doc is your own users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /games/{gameId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.playerIds;
      allow write: if false;

      match /moves/{n} {
        allow read: if request.auth != null
          && request.auth.uid
            in get(/databases/$(database)/documents/games/$(gameId)).data.playerIds;
        allow write: if false;
      }
    }

    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
