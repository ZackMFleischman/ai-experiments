rules_version = '2';

// Deny-all stub except your own users/{uid} doc (DESIGN §5.3). Game and invite
// docs stay server-only: every game mutation goes through a callable (M4).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
