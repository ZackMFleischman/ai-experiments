{
  "name": "hive-root",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -n app,emu -c blue,yellow \"pnpm --filter @hive/app dev\" \"pnpm dev:emulators\"",
    "dev:emulators": "pnpm --filter @hive/functions build && firebase emulators:start --project demo-hive --import packages/functions/emulator-seed",
    "typecheck": "node scripts/check-docs.mjs && pnpm -r --sequential typecheck",
    "test": "pnpm -r --filter '!e2e' test",
    "validate": "pnpm validate:m0 && pnpm validate:m1",
    "validate:m0": "pnpm typecheck && pnpm test && pnpm --filter e2e test",
    "validate:m1": "HIVE_PROP_GAMES=1000 pnpm --filter @hive/engine test",
    "validate:visual": "echo 'validate:visual arrives in M3 (T3.10)' && exit 1",
    "validate:ux": "echo 'validate:ux arrives in M3 (T3.10)' && exit 1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "firebase-tools": "^14.4.0",
    "typescript": "^5.6.3"
  }
}
