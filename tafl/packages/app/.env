# Firebase web-app config for the production project (tafl-zmf).
# ⚑ owner: register tafl-zmf and paste its public identifiers here (safe to
# commit — see GAME-SETUP.md §11). Dev/emulator runs ignore these entirely
# (demo-tafl), and the default build is firebase-free, so the placeholders
# below only matter to the (⚑-gated) firebase deploy job.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tafl-zmf.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tafl-zmf
VITE_FIREBASE_STORAGE_BUCKET=tafl-zmf.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
